{ config, lib, pkgs, ... }:

with lib;

# Hyprland as the HTPC's compositor, replacing Plasma Bigscreen (2026-11-20).
# No display manager: getty auto-logs the user in on tty1 and the login
# shell execs Hyprland (the same setup as Balthasar, the desktop). The config is
# fully declarative: files/hyprland/hyprland.lua plus the generated part
# below, installed as /etc/htpc/hyprland.lua. The TV UI (launcher, overlays)
# comes later from quickshell; until then fuzzel is on the remote's Home key.

let
  cfg = config.services.htpc.desktop.hyprland;
  configPath = "/etc/htpc/hyprland.lua";

  # Nix string -> Lua string literal. JSON escapes (\" \\ \n \t) are valid Lua.
  lua = builtins.toJSON;

  generated = ''

    ------------------------------------------------------------
    ---- GENERATED by modules/desktop/hyprland.nix (options) ----
    ------------------------------------------------------------

    hl.monitor({
        output   = ${lua cfg.monitor.output},
        mode     = ${lua cfg.monitor.mode},
        position = "auto",
        scale    = ${toString cfg.monitor.scale},${optionalString (cfg.monitor.bitdepth != null) "\n    bitdepth = ${toString cfg.monitor.bitdepth},"}
    })
  ''
  + concatStrings (imap1 (i: re: ''
    hl.window_rule({ name = "htpc-fullscreen-${toString i}", match = { class = ${lua "(?i)${re}"} }, fullscreen = true })
  '') cfg.fullscreenApps)
  + optionalString (cfg.autostart != [ ]) ''

    hl.on("hyprland.start", function ()
    ${concatMapStrings (c: "    hl.exec_cmd(${lua c})\n") cfg.autostart}end)
  ''
  + optionalString (cfg.extraConfig != "") ''

    ${cfg.extraConfig}
  '';
in
{
  options.services.htpc.desktop.hyprland = {
    enable = mkEnableOption "Hyprland as the HTPC's compositor, configured entirely from Nix";

    autologin.user = mkOption {
      type = types.nullOr types.str;
      default = null;
      example = "htpc";
      description = ''
        Log this user in automatically on tty1 and start Hyprland from the
        login shell (no display manager). Null: log in by hand, then run
        `start-hyprland -- -c ${configPath}`.
      '';
    };

    monitor = {
      output = mkOption {
        type = types.str;
        default = "HDMI-A-1";
        description = "Connector name of the TV (`hyprctl monitors`). Unlisted monitors still get their preferred mode.";
      };
      mode = mkOption {
        type = types.str;
        default = "preferred";
        example = "3840x2160@120";
        description = "Hyprland monitor mode: `preferred`, `highres`, `highrr`, or WIDTHxHEIGHT@RATE.";
      };
      scale = mkOption {
        type = types.either types.int types.float;
        default = 1;
        description = "Output scale. Quickshell sizes its own UI, so 1 is usually right even at 4K.";
      };
      bitdepth = mkOption {
        type = types.nullOr (types.enum [ 8 10 ]);
        default = null;
        example = 10;
        description = ''
          Output bit depth; null leaves Hyprland's default (8). 10 avoids
          banding and is what HDR is sent at. Check that the TV still shows
          a picture: 4K at 120 Hz in 10-bit needs a full HDMI 2.1 link.
        '';
      };
    };

    cursor = {
      package = mkOption {
        type = types.package;
        default = pkgs.bibata-cursors;
        defaultText = literalExpression "pkgs.bibata-cursors";
        description = "Package providing the cursor theme.";
      };
      theme = mkOption {
        type = types.str;
        default = "Bibata-Modern-Ice";
        description = "Cursor theme name (a directory in the package's share/icons).";
      };
      size = mkOption {
        type = types.int;
        default = 32;
        description = "Cursor size in logical pixels, multiplied by monitor.scale. Big, for an air mouse across the room.";
      };
    };

    fontSize = mkOption {
      type = types.int;
      default = 14;
      description = "Font size (pt, before monitor.scale) for the maintenance terminal (foot) and the launcher (fuzzel).";
    };

    fullscreenApps = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "moonlight" "open-tv" ];
      description = ''
        Case-insensitive regexes matched against window classes (Wayland app
        ids). Matching windows open fullscreen, for apps that start windowed
        and have no fullscreen setting of their own. Find a class with
        `hyprctl clients`.
      '';
    };

    autostart = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "stremio" ];
      description = "Commands run once when Hyprland starts.";
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = "Extra Hyprland Lua appended to the end of the config.";
    };
  };

  config = mkIf cfg.enable (mkMerge [
    {
      programs.hyprland.enable = true;

      environment.etc."htpc/hyprland.lua".text =
        builtins.readFile ../../files/hyprland/hyprland.lua + generated;

      environment.systemPackages = with pkgs; [
        foot        # SUPER+RETURN: a terminal for maintenance
        fuzzel      # launcher on Home / SUPER+SPACE until quickshell
        playerctl   # media keys -> MPRIS
        cfg.cursor.package
      ];

      # Session-wide, so Hyprland, Wayland apps and XWayland apps agree.
      # Hyprland is started from the login shell, which has these.
      environment.sessionVariables = {
        XCURSOR_THEME = cfg.cursor.theme;
        XCURSOR_SIZE = toString cfg.cursor.size;
        HYPRCURSOR_SIZE = toString cfg.cursor.size;
        # Steam is an X11 app: with xwayland.force_zero_scaling it renders
        # at native resolution and needs its own UI scale to match the TV's
        STEAM_FORCE_DESKTOPUI_SCALING = toString cfg.monitor.scale;
      };

      # Readable from the couch. System-wide defaults in /etc/xdg; a user
      # ~/.config file would override them.
      environment.etc."xdg/foot/foot.ini".text = ''
        font=monospace:size=${toString cfg.fontSize}
        pad=12x12

        [colors]
        alpha=0.95
      '';
      environment.etc."xdg/fuzzel/fuzzel.ini".text = ''
        [main]
        font=sans:size=${toString (cfg.fontSize + 6)}
        terminal=foot
        width=40
        lines=10
        horizontal-pad=32
        vertical-pad=24
        inner-pad=12
        icon-theme=hicolor

        [colors]
        background=101418f0
        text=e6e6e6ff
        match=4fc3f7ff
        selection=2a3540ff
        selection-text=ffffffff
        selection-match=4fc3f7ff
        border=4fc3f7ff

        [border]
        width=2
        radius=12
      '';

      # file pickers etc. (xdg-desktop-portal-hyprland has no FileChooser)
      xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];

      services.pipewire = {
        enable = mkDefault true;
        alsa.enable = mkDefault true;
        pulse.enable = mkDefault true;
      };
      security.rtkit.enable = mkDefault true;
    }

    (mkIf (cfg.autologin.user != null) {
      services.getty.autologinUser = cfg.autologin.user;

      # Only that user, only on tty1, only if not already in a session, so
      # ssh logins and other TTYs (Ctrl+Alt+F2) stay plain shells. If
      # Hyprland exits, getty logs in again and it restarts.
      environment.loginShellInit = ''
        if [ "$USER" = ${escapeShellArg cfg.autologin.user} ] && [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = 1 ]; then
          exec start-hyprland -- -c ${configPath}
        fi
      '';
    })
  ]);
}
