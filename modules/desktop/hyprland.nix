{ config, lib, pkgs, ... }:

with lib;

# Hyprland as the HTPC's compositor, replacing Plasma Bigscreen (2026-11-20).
# No display manager: getty auto-logs the user in on tty1 and the login
# shell execs Hyprland (the same setup as Balthasar, the desktop). The config is
# fully declarative: files/hyprland/hyprland.lua plus the generated part
# below, installed as /etc/htpc/hyprland.lua. The TV UI (home screen,
# ribbon, launcher, settings) is the quickshell config in files/quickshell
# (shell.enable); without it, fuzzel is on the remote's Home/Search keys.

let
  cfg = config.services.htpc.desktop.hyprland;
  configPath = "/etc/htpc/hyprland.lua";
  shellDir = "/etc/htpc/quickshell";
  qs = "${cfg.shell.package}/bin/qs";
  shellIpc = fn: "${qs} -p ${shellDir} ipc call shell ${fn}";

  # Nix string -> Lua string literal. JSON escapes (\" \\ \n \t) are valid Lua.
  lua = builtins.toJSON;

  # The remote's Home (+ SUPER+SPACE on a keyboard): the quickshell UI, or
  # fuzzel. Search is deliberately NOT bound with the shell: it should reach
  # the focused app (Stremio has its own search), and the shell's home screen
  # gets it directly when it has focus (nothing open).
  launcherBinds =
    if cfg.shell.enable then ''

      hl.bind("XF86HomePage",  hl.dsp.exec_cmd(${lua (shellIpc "home")}))
      hl.bind("SUPER + SPACE", hl.dsp.exec_cmd(${lua (shellIpc "search")}))
    '' else ''

      hl.bind("XF86HomePage",  hl.dsp.exec_cmd("fuzzel"))
      hl.bind("XF86Search",    hl.dsp.exec_cmd("fuzzel"))
      hl.bind("SUPER + SPACE", hl.dsp.exec_cmd("fuzzel"))
    '';

  # `htpc-tv-hdr on|off`: the TV's normal mode, in HDR or SDR. The quickshell
  # TV UI runs it when an hdrApps window opens / the last one closes (it gets
  # the list as HTPC_HDR_APPS). Done there rather than in a Hyprland
  # window.open handler: handlers registered by the config never fired for
  # window events on 0.57.2 (hyprland.start did), while quickshell already
  # tracks the windows and isn't reset by config reloads.
  htpcTvHdr = pkgs.writeShellScriptBin "htpc-tv-hdr" ''
    case "$1" in
      on)  cm=hdr ;;
      off) cm=srgb ;;
      *)   echo "usage: htpc-tv-hdr on|off" >&2; exit 2 ;;
    esac
    hyprctl eval "hl.monitor({ output = ${lua cfg.monitor.output}, mode = ${lua cfg.monitor.mode}, position = \"auto\", scale = ${toString cfg.monitor.scale}, bitdepth = 10, cm = \"$cm\" })"
    echo "$(date +%T) tv $cm" >> "''${XDG_RUNTIME_DIR:-/tmp}/htpc-hdr.log"
  '';

  shellEnv = "HTPC_SHELL=tv"
    + optionalString (cfg.hdrApps != [ ]) " HTPC_HDR_APPS=${escapeShellArg (concatStringsSep "," cfg.hdrApps)}";

  autostart = optional cfg.shell.enable "env ${shellEnv} ${qs} -p ${shellDir}" ++ cfg.autostart;

  generated = ''

    ------------------------------------------------------------
    ---- GENERATED by modules/desktop/hyprland.nix (options) ----
    ------------------------------------------------------------

    hl.monitor({
        output   = ${lua cfg.monitor.output},
        mode     = ${lua cfg.monitor.mode},
        position = "auto",
        scale    = ${toString cfg.monitor.scale},${optionalString (cfg.monitor.bitdepth != null) "\n    bitdepth = ${toString cfg.monitor.bitdepth},"}
    })
  ''
  + concatStrings (imap1 (i: re: ''
    hl.window_rule({ name = "htpc-fullscreen-${toString i}", match = { class = ${lua "(?i)${re}"} }, fullscreen = true })
  '') cfg.fullscreenApps)
  + launcherBinds
  + optionalString (autostart != [ ]) ''

    hl.on("hyprland.start", function ()
    ${concatMapStrings (c: "    hl.exec_cmd(${lua c})\n") autostart}end)
  ''
  + optionalString (cfg.extraConfig != "") ''

    ${cfg.extraConfig}
  '';
in
{
  options.services.htpc.desktop.hyprland = {
    enable = mkEnableOption "Hyprland as the HTPC's compositor, configured entirely from Nix";

    autologin.user = mkOption {
      type = types.nullOr types.str;
      default = null;
      example = "htpc";
      description = ''
        Log this user in automatically on tty1 and start Hyprland from the
        login shell (no display manager). Null: log in by hand, then run
        `start-hyprland -- -c ${configPath}`.
      '';
    };

    monitor = {
      output = mkOption {
        type = types.str;
        default = "HDMI-A-1";
        description = "Connector name of the TV (`hyprctl monitors`). Unlisted monitors still get their preferred mode.";
      };
      mode = mkOption {
        type = types.str;
        default = "preferred";
        example = "3840x2160@120";
        description = "Hyprland monitor mode: `preferred`, `highres`, `highrr`, or WIDTHxHEIGHT@RATE.";
      };
      scale = mkOption {
        type = types.either types.int types.float;
        default = 1;
        description = "Output scale. Quickshell sizes its own UI, so 1 is usually right even at 4K.";
      };
      bitdepth = mkOption {
        type = types.nullOr (types.enum [ 8 10 ]);
        default = null;
        example = 10;
        description = ''
          Output bit depth; null leaves Hyprland's default (8). 10 avoids
          banding and is what HDR is sent at. Check that the TV still shows
          a picture: 4K at 120 Hz in 10-bit needs a full HDMI 2.1 link.
        '';
      };
    };

    cursor = {
      package = mkOption {
        type = types.package;
        default = pkgs.bibata-cursors;
        defaultText = literalExpression "pkgs.bibata-cursors";
        description = "Package providing the cursor theme.";
      };
      theme = mkOption {
        type = types.str;
        default = "Bibata-Modern-Ice";
        description = "Cursor theme name (a directory in the package's share/icons).";
      };
      size = mkOption {
        type = types.int;
        default = 32;
        description = "Cursor size in logical pixels, multiplied by monitor.scale. Big, for an air mouse across the room.";
      };
    };

    fontSize = mkOption {
      type = types.int;
      default = 14;
      description = "Font size (pt, before monitor.scale) for the maintenance terminal (foot) and the fallback launcher (fuzzel).";
    };

    shell = {
      enable = mkEnableOption ''
        the quickshell TV UI (files/quickshell): home screen with the app
        ribbon and the time/weather pill, the ribbon over open apps (Home),
        the launcher (Search) and settings. Started with Hyprland; the
        remote's Home and Search keys call it. Settings it saves (weather
        location, wallpaper, app cards) live in quickshell's state directory
        on the machine, not in Nix
      '';
      package = mkOption {
        type = types.package;
        default = pkgs.quickshell;
        defaultText = literalExpression "pkgs.quickshell";
        description = "Quickshell package.";
      };
    };

    hdrApps = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "moonlight" ];
      description = ''
        Case-insensitive substrings matched against window classes. While a
        matching window is open the TV runs in HDR (`cm = "hdr"`, 10-bit),
        and goes back to SDR when the last one closes. For apps that send
        HDR but don't signal it to Hyprland, so its own auto-HDR
        (render:cm_auto_hdr) never kicks in. Needs shell.enable: the
        quickshell TV UI watches the windows and runs `htpc-tv-hdr on|off`
        (switches logged to $XDG_RUNTIME_DIR/htpc-hdr.log). Each switch
        makes the TV drop and re-add itself, which the shell's windows follow.
      '';
    };

    fullscreenApps = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "moonlight" "open-tv" ];
      description = ''
        Case-insensitive regexes matched against window classes (Wayland app
        ids). Matching windows open fullscreen, for apps that start windowed
        and have no fullscreen setting of their own. Find a class with
        `hyprctl clients`.
      '';
    };

    autostart = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "stremio" ];
      description = "Commands run once when Hyprland starts.";
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = "Extra Hyprland Lua appended to the end of the config.";
    };
  };

  config = mkIf cfg.enable (mkMerge [
    {
      programs.hyprland.enable = true;

      environment.etc."htpc/hyprland.lua".text =
        builtins.readFile ../../files/hyprland/hyprland.lua + generated;

      environment.systemPackages = with pkgs; [
        foot        # SUPER+RETURN: a terminal for maintenance
        playerctl   # media keys -> MPRIS
        cfg.cursor.package
      ] ++ (if cfg.shell.enable then [ cfg.shell.package ] else [ fuzzel ])
        ++ optional (cfg.hdrApps != [ ]) htpcTvHdr;

      # Session-wide, so Hyprland, Wayland apps and XWayland apps agree.
      # Hyprland is started from the login shell, which has these.
      environment.sessionVariables = {
        XCURSOR_THEME = cfg.cursor.theme;
        XCURSOR_SIZE = toString cfg.cursor.size;
        HYPRCURSOR_SIZE = toString cfg.cursor.size;
        # Steam is an X11 app: with xwayland.force_zero_scaling it renders
        # at native resolution and needs its own UI scale to match the TV's
        STEAM_FORCE_DESKTOPUI_SCALING = toString cfg.monitor.scale;
      };

      # Readable from the couch. System-wide defaults in /etc/xdg; a user
      # ~/.config file would override them.
      environment.etc."xdg/foot/foot.ini".text = ''
        font=monospace:size=${toString cfg.fontSize}
        pad=12x12

        [colors]
        alpha=0.95
      '';
      environment.etc."xdg/fuzzel/fuzzel.ini".enable = !cfg.shell.enable;
      environment.etc."xdg/fuzzel/fuzzel.ini".text = ''
        [main]
        font=sans:size=${toString (cfg.fontSize + 6)}
        terminal=foot
        width=40
        lines=10
        horizontal-pad=32
        vertical-pad=24
        inner-pad=12
        icon-theme=hicolor

        [colors]
        background=101418f0
        text=e6e6e6ff
        match=4fc3f7ff
        selection=2a3540ff
        selection-text=ffffffff
        selection-match=4fc3f7ff
        border=4fc3f7ff

        [border]
        width=2
        radius=12
      '';

      # file pickers etc. (xdg-desktop-portal-hyprland has no FileChooser)
      xdg.portal.extraPortals = [ pkgs.xdg-desktop-portal-gtk ];

      services.pipewire = {
        enable = mkDefault true;
        alsa.enable = mkDefault true;
        pulse.enable = mkDefault true;
      };
      security.rtkit.enable = mkDefault true;
    }

    (mkIf cfg.shell.enable {
      # the UI's QML files; quickshell reloads them when they change
      environment.etc."htpc/quickshell".source = ../../files/quickshell;
    })

    (mkIf (cfg.autologin.user != null) {
      services.getty.autologinUser = cfg.autologin.user;

      # Only that user, only on tty1, only if not already in a session, so
      # ssh logins and other TTYs (Ctrl+Alt+F2) stay plain shells. If
      # Hyprland exits, getty logs in again and it restarts.
      environment.loginShellInit = ''
        if [ "$USER" = ${escapeShellArg cfg.autologin.user} ] && [ -z "$WAYLAND_DISPLAY" ] && [ "$XDG_VTNR" = 1 ]; then
          exec start-hyprland -- -c ${configPath}
        fi
      '';
    })
  ]);
}
